# NEERNETRA — Environment Configuration (Phase 1)

# --- Frontend (Vite) ---
# MapLibre GL JS style URL/config. NEERNETRA uses MapLibre directly — no
# Mapbox account or access token is required. If unset, the app defaults to
# a free, key-less Esri World Imagery satellite raster basemap (built into
# TacticalMap.tsx). Set this to override with any MapLibre-compatible
# vector/raster style URL (self-hosted, MapTiler, Stadia Maps, CARTO, etc.)
# without touching any map-rendering code.
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Base URL the frontend uses to reach the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000/api

# --- Backend (FastAPI) ---
# "mock" (default, Phase 1) or "vesselfinder" (future, Phase 2+)
VESSEL_DATA_PROVIDER=mock

# Only required when VESSEL_DATA_PROVIDER=vesselfinder. NEVER expose this to the frontend.
VESSELFINDER_API_KEY=

# Reserved for future providers (Sentinel Hub / Copernicus, ocean & weather data).
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
OCEAN_DATA_PROVIDER=mock
WEATHER_DATA_PROVIDER=mock

# CORS origin allowed to call the backend during local development.
FRONTEND_ORIGIN=http://localhost:5173
